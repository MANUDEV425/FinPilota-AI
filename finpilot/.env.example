# ==============================================================================
# FinPilot AI – Fetch.ai Multi-Agent Network Environment Configuration (.env)
# ==============================================================================

# ── Agent Ports ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
ORCHESTRATOR_PORT=8001
SCREENER_PORT=8002
RESEARCHER_PORT=8004
TRIGGER_PORT=8003

# ── Agentverse Mailbox Connectivity ───────────────────────────────────────────
# If set, orchestrator registers with Agentverse Mailbox for 24/7 ASI:One routing.
# Format: sk_... (obtained from Agentverse > Profile > API Keys or Mailbox setup)
AGENTVERSE_KEY=sk_your_agentverse_mailbox_key_here
AGENTVERSE_API_KEY=sk_your_agentverse_mailbox_key_here

# ── Agent Seeds (change in production for private unique identities) ──────────
ORCHESTRATOR_SEED=orchestrator_default_seed_finpilot_ai_v1_replace_in_prod
SCREENER_SEED=screener_default_seed_finpilot_ai_v1_replace_in_prod
RESEARCHER_SEED=researcher_default_seed_finpilot_ai_v1_replace_in_prod

# ── Deterministic Agent Addresses (derived from seeds) ────────────────────────
ORCHESTRATOR_AGENT_ADDRESS=agent1qg9wlw06ulhcjcwvfghyrtkdyzcfngaf4jsysdtughqfu8swlp9ryrk2vzm
SCREENER_AGENT_ADDRESS=agent1qgrmhgl5z5exyd7wre4v0t38lu64hcwwqde56eym9x55w7pk6whzcu3karf
RESEARCHER_AGENT_ADDRESS=agent1qtzv0v7hcpc7dvk23e7ugzsh29edr7v07r5elflddjj5e8axq6f6zn0d3d4

# ── Quantitative Screening Filters ────────────────────────────────────────────
MAX_PE_RATIO=40.0
MIN_PE_RATIO=0.0
MAX_PB_RATIO=6.0
MAX_RESULTS=5

# ── LLM Integration (Optional – falls back to deterministic quant engine if omitted)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
MAX_COMPLETION_TOKENS=2048
